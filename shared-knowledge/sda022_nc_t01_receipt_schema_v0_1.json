{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-knowledge/sda022_nc_t01_receipt_schema_v0_1.json",
  "title": "SDA-022 NC-T01 Physical Independence Receipt V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "receiptHash",
    "decisionAt",
    "strategyId",
    "strategyVersion",
    "system1Top6InputAvailable",
    "system1RankInputAvailable",
    "hiddenFallbackAudit",
    "sharedRawSourceRefs",
    "candidateUniverseProvenance",
    "requiredInputsState",
    "executionState",
    "candidateGenerationExecutable",
    "zeroPickDisposition",
    "generatedCandidates",
    "sourceGenerationRefs",
    "resultClassification",
    "formalMutation",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "SDA022_NC_T01_RECEIPT_V0_1"
    },
    "receiptId": {
      "type": "string",
      "minLength": 1
    },
    "receiptHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionAt": {
      "type": "string",
      "minLength": 1
    },
    "strategyId": {
      "type": "string",
      "minLength": 1
    },
    "strategyVersion": {
      "type": "string",
      "minLength": 1
    },
    "system1Top6InputAvailable": {
      "const": false
    },
    "system1RankInputAvailable": {
      "const": false
    },
    "hiddenFallbackAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cachedSystem1SelectionUsed",
        "persistedSystem1SelectionUsed",
        "aliasReconstructionUsed",
        "crossProjectFallbackUsed",
        "staleSharedStateUsed"
      ],
      "properties": {
        "cachedSystem1SelectionUsed": {
          "const": false
        },
        "persistedSystem1SelectionUsed": {
          "const": false
        },
        "aliasReconstructionUsed": {
          "const": false
        },
        "crossProjectFallbackUsed": {
          "const": false
        },
        "staleSharedStateUsed": {
          "const": false
        }
      }
    },
    "sharedRawSourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidateUniverseProvenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredInputsState": {
      "enum": [
        "READY",
        "INCOMPLETE",
        "UNKNOWN"
      ]
    },
    "executionState": {
      "enum": [
        "EXECUTED",
        "BLOCKED_INPUTS",
        "RUNTIME_FAILURE",
        "GLOBAL_PRIORITY_UNRESOLVED"
      ]
    },
    "candidateGenerationExecutable": {
      "type": "boolean"
    },
    "zeroPickDisposition": {
      "enum": [
        "NOT_ZERO_PICK",
        "LEGITIMATE_ZERO_PICK",
        "INPUT_INCOMPLETE",
        "DEPENDENCY_BLOCKED",
        "RUNTIME_FAILURE",
        "CAPACITY_UNRESOLVED"
      ]
    },
    "generatedCandidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sourceGenerationRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "resultClassification": {
      "enum": [
        "PHYSICALLY_INDEPENDENT_PATH_OBSERVED",
        "NOT_PHYSICALLY_PROVEN",
        "HIDDEN_SYSTEM1_DEPENDENCY",
        "EVIDENCE_INCOMPLETE"
      ]
    },
    "formalMutation": {
      "const": false
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
